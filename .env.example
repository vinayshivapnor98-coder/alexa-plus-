# AI provider (Gemini by default). Save this file as ".env" (exactly that name) next to web_app.py, then restart.
# No quotes or spaces around the key.
# Google AI Studio offers Gemini API free-tier access subject to its current limits.
# Get a key at: https://aistudio.google.com/apikey
AI_API_KEY=PASTE_YOUR_KEY_HERE
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Optional path for the SQLite database. Default: ./data/assistant.db
# ALEXA_AGENT_DB=C:\\path\\to\\assistant.db

# Set to 0 to disable sample inventory records on first run.
LOAD_DEMO_DATA=1

# Funny answers (default). Set to "normal" for plain answers.
ALEXA_PERSONALITY=funny

# Let the app open YouTube/Spotify on this PC for "open ..." and "play ... on spotify" (1 = yes).
ALEXA_OPEN_ON_PC=1

# Country code added to phone numbers you save for WhatsApp calls/messages (no +).
DEFAULT_COUNTRY_CODE=91
